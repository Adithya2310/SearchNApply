# Copy this file to .env and fill in real values. Never commit .env.
# For GitHub Actions, add the same values as repo Secrets instead.

# --- Google Sheets (the database) — required for Phase 1 ---
# Service account JSON key with edit access to the target Sheet.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json
# The ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Gmail (M5 Digest, M6 Watchlist alerts) — required for Phase 1 ---
# Requires 2FA enabled, then an App Password generated under Google Account > Security.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Adzuna (M1 Aggregator) — required for Phase 1 ---
# Sign up at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- JSearch via RapidAPI (M1 Aggregator) — required for Phase 1 ---
# Sign up at rapidapi.com, subscribe to JSearch
RAPIDAPI_KEY=

# --- Contact finder (M8) — required for Phase 2 ---
# Pick one: Hunter.io or Apollo.io
HUNTER_API_KEY=
APOLLO_API_KEY=

# --- AI provider abstraction (M14) — used by M3, M4, M9, M10 ---
# One of: claude / gemini / none
AI_PROVIDER=none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
